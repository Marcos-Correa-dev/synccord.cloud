# =============================================================================
# SyncCord Backend - Environment Configuration (SyncCord.cloud)
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v10
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Database Options (Standard PostgreSQL Compatible)
# =============================================================================
# Option 1: Local PostgreSQL (Docker Compose on port 5435)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/synccord_db

# If using your existing PostgreSQL on port 5432:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synccord_db

# Option 2: Neon.tech Serverless PostgreSQL (uncomment to use)
# DATABASE_URL=postgresql://neondb_owner:password@ep-cool-branch.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 3: Supabase PostgreSQL (uncomment to use)
# Direct connection (port 5432) or PgBouncer/Supavisor pooled connection (port 6543)
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# =============================================================================
# Cache & Real-time Synchronization
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Authentication (JWT)
# =============================================================================
JWT_SECRET=super_secret_discord_jwt_key_change_in_production_2026
JWT_EXPIRATION=900s
REFRESH_TOKEN_EXPIRATION=30d

# =============================================================================
# File Storage (VPS Local Storage - Ultra Lightweight & Zero Cloud Cost)
# =============================================================================
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./public/uploads
MAX_FILE_SIZE_MB=25

# =============================================================================
# Mediasoup Voice & Video SFU (Selective Forwarding Unit)
# =============================================================================
# In production on your VPS, set this to your VPS Public IP (e.g., 142.93.xxx.xxx)
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=20000
MEDIASOUP_MAX_PORT=29999

# =============================================================================
# Snowflake ID Generator Configuration
# =============================================================================
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_PROCESS_ID=1
